# Comma-separated keys your website will send as X-API-Key
API_KEYS=change-me-to-a-long-random-string

# Cache freshness (seconds). 21600 = 6 hours
CACHE_TTL=21600
STALE_MAX_AGE=172800

# Residential proxies (comma separated). Leave empty to start; add when you see blocks.
# PROXIES=http://user:pass@in.proxyprovider.com:8000
PROXIES=

HEADLESS=true
MAX_RETRIES=3
PER_PLATFORM_COOLDOWN=5
MAX_CONCURRENCY=2

# Auto-refresh tracked products every 6h (0 = disabled)
REFRESH_INTERVAL=21600
DEFAULT_PINCODE=413001
